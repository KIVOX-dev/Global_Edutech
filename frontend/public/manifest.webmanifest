{
  "name": "Global Edutech",
  "short_name": "Global Edutech",
  "description": "Global Edutech admin and staff portal: attendance, fees and enquiries.",
  "id": "/",
  "start_url": "/login?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#763dcb",
  "lang": "en-IN",
  "categories": ["education", "business"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Attendance", "url": "/admin/attendance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Enquiries", "url": "/admin/enquiries", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Fees", "url": "/admin/fees", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
