# ===== Institute management system (Phase 1+). Replace every your_ / changeme value =====
NODE_ENV=development
PORT=9000
APP_URL=http://localhost:5173
APP_TIMEZONE=Asia/Kolkata
INSTITUTE_NAME=Global Edutech
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster.mongodb.net/global_edutech?retryWrites=true&w=majority
JWT_ACCESS_SECRET=changeme_long_random_string_1
JWT_REFRESH_SECRET=changeme_long_random_string_2
COOKIE_DOMAIN=localhost
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=changeme_strong_password
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET=your_bucket_name
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=Global Edutech
REMINDER_CRON_TIME=10:00
# Optional: text shown in reminder emails ({payment_instructions})
PAYMENT_INSTRUCTIONS=Pay at the institute office or by UPI / bank transfer and share the reference.

# Website enquiry notifications go to this address (defaults to BREVO_SENDER_EMAIL)
CONTACT_RECEIVER_EMAIL=
